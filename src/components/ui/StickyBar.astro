---
import { config } from '@/config';
const { business } = config;
---

<div
  id="sticky-bar"
  class="lg:hidden fixed bottom-0 left-0 right-0 z-40 flex opacity-0 translate-y-full pointer-events-none transition-all duration-300"
  aria-hidden="true"
>
  <a
    href={`tel:${business.phone.replace(/\s/g,'')}`}
    class="flex-1 flex items-center justify-center gap-2 py-4 text-sm font-semibold text-white"
    style="background-color: var(--color-primary);"
  >
    📞 Call Now
  </a>
  <a
    href="#contact"
    class="flex-1 flex items-center justify-center gap-2 py-4 text-sm font-semibold text-white"
    style="background-color: var(--color-accent);"
  >
    Get a Quote
  </a>
</div>
