---
import Icon from './Icon.astro';

interface Props {
  icon:        string;
  name:        string;
  description: string;
  layout?:     'grid' | 'list';
  href?:       string;
}
const { icon, name, description, layout = 'grid', href } = Astro.props;

const baseListClass  = "flex items-start gap-5 p-6 rounded-xl border bg-gray-50 transition-all duration-200";
const baseGridClass  = "p-6 rounded-xl border bg-gray-50 transition-all duration-200 flex flex-col items-start";
const staticStyle    = "border-gray-200 shadow-sm hover:shadow-md";
const linkStyle      = "border-gray-200 shadow-sm hover:shadow-md hover:border-[var(--color-accent)] cursor-pointer group";
---

{layout === 'list' ? (
  href ? (
    <a href={href} class={`${baseListClass} ${linkStyle}`}>
      <div
        class="shrink-0 w-12 h-12 rounded-lg flex items-center justify-center mt-0.5"
        style="background-color: color-mix(in srgb, var(--color-accent) 12%, white);"
      >
        <Icon name={icon} size={24} style="color: var(--color-accent);" />
      </div>
      <div class="flex-1">
        <h3 class="font-heading font-semibold text-gray-900 text-base mb-1">{name}</h3>
        <p class="text-gray-500 text-sm leading-relaxed">{description}</p>
        <span class="inline-flex items-center gap-1 mt-2 text-xs font-semibold transition-colors duration-150" style="color: var(--color-accent);">
          Get a Quote
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 translate-x-0 group-hover:translate-x-0.5 transition-transform duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </span>
      </div>
    </a>
  ) : (
    <div class={`${baseListClass} ${staticStyle}`}>
      <div
        class="shrink-0 w-12 h-12 rounded-lg flex items-center justify-center mt-0.5"
        style="background-color: color-mix(in srgb, var(--color-accent) 12%, white);"
      >
        <Icon name={icon} size={24} style="color: var(--color-accent);" />
      </div>
      <div>
        <h3 class="font-heading font-semibold text-gray-900 text-base mb-1">{name}</h3>
        <p class="text-gray-500 text-sm leading-relaxed">{description}</p>
      </div>
    </div>
  )
) : (
  href ? (
    <a href={href} class={`${baseGridClass} ${linkStyle}`}>
      <div
        class="w-12 h-12 rounded-lg flex items-center justify-center mb-4"
        style="background-color: color-mix(in srgb, var(--color-accent) 12%, white);"
      >
        <Icon name={icon} size={24} style="color: var(--color-accent);" />
      </div>
      <h3 class="font-heading font-semibold text-gray-900 text-base mb-2">{name}</h3>
      <p class="text-gray-500 text-sm leading-relaxed flex-1">{description}</p>
      <span class="inline-flex items-center gap-1 mt-4 text-xs font-semibold transition-colors duration-150" style="color: var(--color-accent);">
        Get a Quote
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 translate-x-0 group-hover:translate-x-0.5 transition-transform duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </span>
    </a>
  ) : (
    <div class={`${baseGridClass} ${staticStyle}`}>
      <div
        class="w-12 h-12 rounded-lg flex items-center justify-center mb-4"
        style="background-color: color-mix(in srgb, var(--color-accent) 12%, white);"
      >
        <Icon name={icon} size={24} style="color: var(--color-accent);" />
      </div>
      <h3 class="font-heading font-semibold text-gray-900 text-base mb-2">{name}</h3>
      <p class="text-gray-500 text-sm leading-relaxed">{description}</p>
    </div>
  )
)}
