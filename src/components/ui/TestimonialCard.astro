---
import StarRating from './StarRating.astro';

interface Props {
  name:     string;
  location: string;
  text:     string;
  rating:   1 | 2 | 3 | 4 | 5;
}
const { name, location, text, rating } = Astro.props;
---

<div class="rounded-xl p-6 bg-white/10 flex flex-col gap-4">
  <StarRating rating={rating} />
  <p class="text-white/90 text-sm leading-relaxed flex-1">"{text}"</p>
  <div>
    <p class="font-heading font-semibold text-white text-sm">{name}</p>
    <p class="text-white/50 text-xs">{location}</p>
  </div>
</div>
