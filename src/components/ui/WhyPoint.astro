---
import Icon from './Icon.astro';

interface Props {
  icon: string;
  text: string;
}
const { icon, text } = Astro.props;
---

<div class="flex flex-col items-center text-center p-6 bg-white rounded-2xl border border-[#1f3a5f]/20 shadow-sm">
  <div
    class="w-14 h-14 rounded-xl flex items-center justify-center mb-4"
    style="background-color: color-mix(in srgb, var(--color-accent) 12%, white);"
  >
    <Icon name={icon} size={28} style="color: var(--color-accent);" />
  </div>
  <p class="text-gray-700 text-sm leading-relaxed font-medium">{text}</p>
</div>
