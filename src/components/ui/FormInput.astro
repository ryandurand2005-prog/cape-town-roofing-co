---
import type { FormField } from '@/config/types';

interface Props {
  field:        FormField;
  label:        string;
  required?:    boolean;
  placeholder?: string;
  options?:     string[];
}

const { field, label, required = false, placeholder = '', options = [] } = Astro.props;

const inputBase = 'w-full px-4 py-3 rounded-lg border border-gray-300 text-gray-900 bg-white placeholder-gray-400 text-sm focus:outline-none focus:ring-2 transition-colors duration-150';
const inputStyle = 'focus:border-[var(--color-accent)] focus:ring-[color-mix(in_srgb,var(--color-accent)_30%,transparent)]';
---

<div class="form-field" data-field={field}>
  <label
    for={field}
    class="block text-sm font-medium text-gray-700 mb-1"
  >
    {label}{required && <span class="text-red-500 ml-0.5" aria-hidden="true">*</span>}
  </label>

  {field === 'message' ? (
    <textarea
      id={field}
      name={field}
      rows={4}
      placeholder={placeholder}
      required={required}
      class={`${inputBase} ${inputStyle} resize-none`}
      aria-describedby={`${field}-error`}
    />
  ) : field === 'service' ? (
    <select
      id={field}
      name={field}
      required={required}
      class={`${inputBase} ${inputStyle}`}
      aria-describedby={`${field}-error`}
    >
      <option value="">Select a service…</option>
      {options.map(opt => (
        <option value={opt}>{opt}</option>
      ))}
    </select>
  ) : (
    <input
      id={field}
      name={field}
      type={field === 'email' ? 'email' : field === 'phone' ? 'tel' : 'text'}
      placeholder={placeholder}
      required={required}
      class={`${inputBase} ${inputStyle}`}
      aria-describedby={`${field}-error`}
      autocomplete={field === 'email' ? 'email' : field === 'phone' ? 'tel' : field === 'name' ? 'name' : 'off'}
    />
  )}

  <p id={`${field}-error`} class="field-error mt-1 text-sm text-red-600 hidden" role="alert"></p>
</div>
