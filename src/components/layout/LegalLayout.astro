---
/**
 * LegalLayout.astro
 * ─────────────────
 * Clean, readable layout for legal pages (Privacy, Terms, Cookies).
 * Uses the site header and footer for consistency, but strips all
 * marketing chrome. Content is rendered in a centred prose container.
 *
 * Props:
 *   title       — Page <title> and H1
 *   description — Meta description
 *   lastUpdated — Date string shown below the H1 (formatted for display)
 */

import { config } from '@/config';

interface Props {
  title:       string;
  description: string;
  lastUpdated: string;
}

const { title, description, lastUpdated } = Astro.props;

// Format lastUpdated from YYYY-MM-DD to "1 May 2026"
const formattedDate = new Date(lastUpdated).toLocaleDateString('en-ZA', {
  day:   'numeric',
  month: 'long',
  year:  'numeric',
});
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />

  <!-- Legal pages are not valuable search results — exclude from index -->
  <meta name="robots" content="noindex, follow" />

  <title>{title} — {config.business.name}</title>

  <!-- Fonts: same as main site for visual consistency -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href={`https://fonts.googleapis.com/css2?family=${config.theme.fontHeading.replace(' ', '+')}:wght@600;700&family=${config.theme.fontBody.replace(' ', '+')}:wght@400;500&display=swap`}
    rel="stylesheet"
  />

  <style define:vars={{
    primaryColor: config.theme.primaryColor,
    accentColor:  config.theme.accentColor,
  }}>
    :root {
      --color-primary: var(--primaryColor);
      --color-accent:  var(--accentColor);
    }
  </style>
</head>

<body class="bg-white text-gray-800 antialiased">

  <!-- ── Minimal Header ─────────────────────────────────── -->
  <header class="border-b border-gray-100 py-4">
    <div class="max-w-4xl mx-auto px-4 md:px-6 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group">
        <img
          src={config.business.logo}
          alt={`${config.business.name} logo`}
          class="h-8 w-auto"
          loading="eager"
        />
        <span class="font-semibold text-gray-900 group-hover:text-[var(--color-primary)] transition-colors">
          {config.business.name}
        </span>
      </a>
      <a
        href="/"
        class="text-sm text-gray-500 hover:text-[var(--color-primary)] transition-colors"
      >
        ← Back to site
      </a>
    </div>
  </header>

  <!-- ── Legal Content ──────────────────────────────────── -->
  <main class="max-w-4xl mx-auto px-4 md:px-6 py-12 md:py-16">

    <!-- Page heading -->
    <div class="mb-10 pb-8 border-b border-gray-100">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2"
          style={`font-family: '${config.theme.fontHeading}', system-ui, sans-serif`}>
        {title}
      </h1>
      <p class="text-sm text-gray-400">Last updated: {formattedDate}</p>
    </div>

    <!-- Legal prose -->
    <div
      class="legal-prose"
      style={`font-family: '${config.theme.fontBody}', system-ui, sans-serif`}
    >
      <slot />
    </div>

  </main>

  <!-- ── Minimal Footer ─────────────────────────────────── -->
  <footer class="border-t border-gray-100 py-8 mt-8">
    <div class="max-w-4xl mx-auto px-4 md:px-6 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-gray-400">
      <p>&copy; {new Date().getFullYear()} {config.business.name}. All rights reserved.</p>
      <nav class="flex gap-6">
        <a href="/privacy" class="hover:text-gray-600 transition-colors">Privacy Policy</a>
        <a href="/terms"   class="hover:text-gray-600 transition-colors">Terms &amp; Conditions</a>
        <a href="/cookies" class="hover:text-gray-600 transition-colors">Cookie Notice</a>
      </nav>
    </div>
  </footer>

</body>
</html>

<!-- ── Prose Styles ────────────────────────────────────────────────────────── -->
<!--
  Tailwind does not style bare HTML elements by default.
  These styles give the legal prose clean, readable formatting
  without requiring the @tailwindcss/typography plugin.
-->
<style is:global>
  .legal-prose h2 {
    font-size:     1.375rem;
    font-weight:   700;
    color:         #111827;
    margin-top:    2.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid #f3f4f6;
  }

  .legal-prose h3 {
    font-size:     1.125rem;
    font-weight:   600;
    color:         #1f2937;
    margin-top:    1.75rem;
    margin-bottom: 0.5rem;
  }

  .legal-prose p {
    font-size:     1rem;
    line-height:   1.75;
    color:         #374151;
    margin-bottom: 1rem;
  }

  .legal-prose ul {
    list-style:    disc;
    padding-left:  1.5rem;
    margin-bottom: 1rem;
  }

  .legal-prose ul li {
    font-size:     1rem;
    line-height:   1.75;
    color:         #374151;
    margin-bottom: 0.375rem;
  }

  .legal-prose a {
    color:           var(--color-accent);
    text-decoration: underline;
  }

  .legal-prose a:hover {
    opacity: 0.8;
  }

  .legal-prose strong {
    font-weight: 600;
    color:       #111827;
  }

  .legal-prose .highlight-box {
    background:    #f9fafb;
    border:        1px solid #e5e7eb;
    border-radius: 0.5rem;
    padding:       1rem 1.25rem;
    margin-top:    1rem;
    margin-bottom: 1.5rem;
  }

  .legal-prose .highlight-box p {
    margin-bottom: 0.25rem;
    font-size:     0.9375rem;
  }

  .legal-prose .highlight-box p:last-child {
    margin-bottom: 0;
  }
</style>
