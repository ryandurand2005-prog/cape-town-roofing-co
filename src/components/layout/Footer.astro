---
import { config } from '@/config';

const { business, footer, sections } = config;
const year = new Date().getFullYear();

const navLinks = [
  { label: 'Home',     href: '#hero' },
  ...(sections.about      ? [{ label: 'About',    href: '#about' }]    : []),
  ...(sections.services   ? [{ label: 'Services', href: '#services' }] : []),
  { label: 'Contact', href: '#contact' },
];
---

<footer style="background-color: var(--color-primary);" class="text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

      <!-- Brand column -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <img
            src={business.logo}
            alt={business.logoAlt}
            width="40"
            height="40"
            class="h-10 w-auto brightness-0 invert"
            onerror="this.style.display='none'"
          />
          <span class="font-heading font-bold text-lg">{business.name}</span>
        </div>
        <p class="text-white/70 text-sm leading-relaxed">{footer.tagline}</p>

        {footer.showSocials && (
          <div class="flex gap-3 mt-4">
            {footer.facebook  && <a href={footer.facebook}  target="_blank" rel="noopener noreferrer" aria-label="Facebook"  class="text-white/60 hover:text-white transition-colors">FB</a>}
            {footer.instagram && <a href={footer.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-white/60 hover:text-white transition-colors">IG</a>}
            {footer.linkedin  && <a href={footer.linkedin}  target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"  class="text-white/60 hover:text-white transition-colors">LI</a>}
          </div>
        )}
      </div>

      <!-- Navigation column -->
      <div>
        <h3 class="font-heading font-semibold text-sm uppercase tracking-wider text-white/50 mb-4">Navigation</h3>
        <ul class="space-y-2">
          {navLinks.map(link => (
            <li>
              <a href={link.href} class="text-white/70 hover:text-white text-sm transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact column -->
      <div>
        <h3 class="font-heading font-semibold text-sm uppercase tracking-wider text-white/50 mb-4">Contact Us</h3>
        <ul class="space-y-3 text-sm text-white/70">
          <li>
            <a href={`tel:${business.phone.replace(/\s/g, '')}`} class="hover:text-white transition-colors flex items-start gap-2">
              <span class="shrink-0 mt-0.5">📞</span>
              <span>{business.phone}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${business.email}`} class="hover:text-white transition-colors flex items-start gap-2">
              <span class="shrink-0 mt-0.5">✉️</span>
              <span>{business.email}</span>
            </a>
          </li>
          <li class="flex items-start gap-2">
            <span class="shrink-0 mt-0.5">📍</span>
            <span>{business.address}, {business.city}, {business.postalCode}</span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="mt-10 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/40">
      <p>&copy; {year} {business.name}. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="/privacy" class="hover:text-white/70 transition-colors">Privacy Policy</a>
        <a href="/terms"   class="hover:text-white/70 transition-colors">Terms &amp; Conditions</a>
        <a href="/cookies" class="hover:text-white/70 transition-colors">Cookie Notice</a>
      </div>
    </div>

  </div>
</footer>
