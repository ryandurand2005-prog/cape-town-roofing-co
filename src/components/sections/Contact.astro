---
import { config }   from '@/config';
import FormInput    from '@/components/ui/FormInput.astro';
import Icon         from '@/components/ui/Icon.astro';

const { contact, business } = config;

const fieldLabels: Record<string, string> = {
  name:    'Your Name',
  phone:   'Phone Number',
  email:   'Email Address',
  service: 'Service Required',
  message: 'Message',
};

const fieldPlaceholders: Record<string, string> = {
  name:    'e.g. John Smith',
  phone:   'e.g. 021 555 1234',
  email:   'e.g. john@example.com',
  service: '',
  message: 'Tell us about your project…',
};

const requiredFields = ['name', 'email', 'message'];
---

<section id="contact" class="py-20 lg:py-28" style="background-color: #cdc7bc;">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="font-heading font-bold text-3xl lg:text-4xl text-gray-900 mb-3">{contact.heading}</h2>
      <p class="text-gray-700 text-lg max-w-xl mx-auto">{contact.subheading}</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-16 items-start">

      <!-- Form column (3/5 on desktop) -->
      <div class="lg:col-span-3 bg-white rounded-2xl shadow-md border border-gray-200 p-8">

        <!-- Success state (hidden by default) -->
        <div id="form-success" class="hidden text-center py-8">
          <div class="flex justify-center mb-4">
            <Icon name="check-circle" size={56} style="color: var(--color-accent);" />
          </div>
          <h3 class="font-heading font-bold text-xl text-gray-900 mb-2">Thank you, we'll be in touch!</h3>
          <p class="text-gray-500 mb-6">We've received your message and will respond within 24 hours.</p>
          <p class="text-sm text-gray-400">Need to speak with someone now?</p>
          <a
            href={`tel:${business.phone.replace(/\s/g,'')}`}
            class="inline-flex items-center gap-2 mt-3 px-6 py-3 rounded-lg font-semibold text-white text-sm"
            style="background-color: var(--color-accent);"
          >
            <Icon name="phone" size={16} />
            Call {business.phone}
          </a>
        </div>

        <!-- General error banner (hidden by default) -->
        <div id="form-error-banner" class="hidden mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700" role="alert">
          <p id="form-error-text">We couldn't send your message. Please try again or call us directly.</p>
          <a href={`tel:${business.phone.replace(/\s/g,'')}`} class="inline-flex items-center gap-1 font-semibold underline mt-1">
            <Icon name="phone" size={14} />
            Call {business.phone}
          </a>
        </div>

        <!-- The form -->
        <form id="contact-form" novalidate>

          <div class="space-y-5">
            {contact.formFields.map(field => (
              <FormInput
                field={field}
                label={fieldLabels[field] ?? field}
                required={requiredFields.includes(field)}
                placeholder={fieldPlaceholders[field] ?? ''}
                options={field === 'service' ? contact.serviceOptions : []}
              />
            ))}
          </div>

          <!-- Honeypot -->
          <div class="hidden" aria-hidden="true">
            <label for="_honeypot">Leave this blank</label>
            <input type="text" id="_honeypot" name="_honeypot" tabindex="-1" autocomplete="off" />
          </div>

          <!-- reCAPTCHA attribution (badge hidden via CSS) -->
          {contact.recaptchaSiteKey && (
            <p class="mt-4 text-xs text-gray-400">
              Protected by reCAPTCHA - <a href="https://policies.google.com/privacy" class="underline">Privacy</a> &amp; <a href="https://policies.google.com/terms" class="underline">Terms</a> apply.
            </p>
          )}

          <div class="mt-6">
            <button
              id="submit-btn"
              type="submit"
              class="w-full flex items-center justify-center gap-2 px-6 py-4 rounded-lg font-semibold text-white text-base transition-colors duration-150 disabled:opacity-60 disabled:cursor-not-allowed"
              style="background-color: var(--color-accent);"
            >
              <span id="submit-text">Send Message</span>
              <span id="submit-spinner" class="hidden">
                <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
                </svg>
              </span>
            </button>
          </div>

        </form>
      </div>

      <!-- Details column (2/5 on desktop) -->
      <div class="lg:col-span-2 space-y-6">

        <!-- Phone CTA (prominent on mobile) -->
        <div class="bg-white rounded-2xl border border-gray-200 shadow-md p-6">
          <p class="text-sm text-gray-500 mb-1">Prefer to call?</p>
          <a
            href={`tel:${business.phone.replace(/\s/g,'')}`}
            class="flex items-center gap-3 font-heading font-bold text-xl hover:opacity-80 transition-opacity"
            style="color: var(--color-primary);"
          >
            <Icon name="phone" size={22} style="color: var(--color-primary);" />
            {business.phone}
          </a>
          <p class="text-xs text-gray-500 mt-2">Available Monday-Friday, 8am-5pm</p>
        </div>

        <!-- Address + email -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 space-y-4 text-sm">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1">Email</p>
            <a href={`mailto:${business.email}`} class="text-gray-700 hover:underline">{business.email}</a>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1">Address</p>
            <p class="text-gray-700">{business.address}, {business.city}, {business.postalCode}</p>
          </div>
        </div>

        <!-- Google Maps embed (optional) -->
        {contact.showMap && contact.mapEmbedUrl && (
          <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-md aspect-video">
            <iframe
              src={contact.mapEmbedUrl}
              width="100%"
              height="100%"
              style="border:0;"
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
              title="Business location map"
            />
          </div>
        )}

      </div>
    </div>
  </div>
</section>

<script is:inline>
// Auto-fill "Service Required" from ?service= URL param when navigating from a service card
(function () {
  function findBestMatch(param, selectEl) {
    const options = Array.from(selectEl.options).map(o => o.value).filter(Boolean);
    const p = param.toLowerCase().trim();

    // 1. Exact match (case-insensitive)
    const exact = options.find(o => o.toLowerCase() === p);
    if (exact) return exact;

    // 2. Word-overlap scoring
    const pWords = p.split(/\W+/).filter(Boolean);
    let best = null, bestScore = 0;
    for (const opt of options) {
      const oWords = opt.toLowerCase().split(/\W+/).filter(Boolean);
      const shared = pWords.filter(w => oWords.some(o => o.includes(w) || w.includes(o)));
      const score = shared.length / Math.max(pWords.length, oWords.length);
      if (score > bestScore) { bestScore = score; best = opt; }
    }
    return bestScore >= 0.4 ? best : null;
  }

  function prefillService() {
    const param = new URLSearchParams(window.location.search).get('service');
    if (!param) return;

    const select = document.getElementById('service');
    if (!select) return;

    const match = findBestMatch(param, select);
    if (match) select.value = match;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', prefillService);
  } else {
    prefillService();
  }
})();
</script>

<script is:inline define:vars={{ siteKey: contact.recaptchaSiteKey }}>
(function () {
  const form       = document.getElementById('contact-form');
  const submitBtn  = document.getElementById('submit-btn');
  const submitText = document.getElementById('submit-text');
  const spinner    = document.getElementById('submit-spinner');
  const success    = document.getElementById('form-success');
  const errBanner  = document.getElementById('form-error-banner');
  const errText    = document.getElementById('form-error-text');

  if (!form) return;

  function setLoading(on) {
    submitBtn.disabled = on;
    submitText.textContent = on ? 'Sending…' : 'Send Message';
    spinner.classList.toggle('hidden', !on);
  }

  function clearFieldErrors() {
    document.querySelectorAll('.field-error').forEach(el => {
      el.textContent = '';
      el.classList.add('hidden');
    });
    document.querySelectorAll('.form-field input, .form-field textarea, .form-field select').forEach(el => {
      el.classList.remove('border-red-500');
    });
  }

  function showFieldErrors(errors) {
    for (const [field, msg] of Object.entries(errors)) {
      const errEl = document.getElementById(`${field}-error`);
      const inputEl = document.getElementById(field);
      if (errEl) { errEl.textContent = msg; errEl.classList.remove('hidden'); }
      if (inputEl) inputEl.classList.add('border-red-500');
    }
  }

  function getFormData() {
    const data = {};
    new FormData(form).forEach((val, key) => { data[key] = val; });
    return data;
  }

  async function doSubmit(recaptchaToken) {
    clearFieldErrors();
    errBanner.classList.add('hidden');

    const body = { ...getFormData(), recaptchaToken };

    let res, json;
    try {
      res  = await fetch('/api/submit', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      json = await res.json();
    } catch {
      setLoading(false);
      errText.textContent = 'Network error. Please check your connection or call us directly.';
      errBanner.classList.remove('hidden');
      return;
    }

    setLoading(false);

    if (json.success) {
      form.classList.add('hidden');
      success.classList.remove('hidden');
      errBanner.classList.add('hidden');
    } else if (json.errors) {
      showFieldErrors(json.errors);
    } else {
      errText.textContent = json.message ?? 'Something went wrong. Please call us directly.';
      errBanner.classList.remove('hidden');
    }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    setLoading(true);

    if (siteKey) {
      try {
        grecaptcha.ready(async () => {
          const token = await grecaptcha.execute(siteKey, { action: 'contact_form' });
          await doSubmit(token);
        });
      } catch {
        await doSubmit('');
      }
    } else {
      await doSubmit('');
    }
  });
})();
</script>
