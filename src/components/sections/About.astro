---
import { config }   from '@/config';
import CTAButton    from '@/components/ui/CTAButton.astro';

const { about } = config;
---

<section id="about" class="py-20 lg:py-28" style="background-color: #f5f3ef;" data-reveal>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">

      <!-- Image -->
      <div class="order-1 lg:order-1">
        <img
          src={about.image}
          alt={about.imageAlt}
          width="600"
          height="450"
          loading="lazy"
          decoding="async"
          class="w-full rounded-xl shadow-lg object-cover aspect-[4/3]"
        />
      </div>

      <!-- Text -->
      <div class="order-2 lg:order-2">
        <h2 class="font-heading font-bold text-3xl lg:text-4xl text-gray-900 mb-5 leading-tight">
          {about.heading}
        </h2>
        <p class="text-gray-600 text-lg leading-relaxed mb-8">
          {about.body}
        </p>
        <CTAButton href={about.ctaHref} variant="primary">
          {about.ctaText}
        </CTAButton>
      </div>

    </div>
  </div>
</section>
