---
import { config } from '@/config';

const { hero, business } = config;
---

<section id="hero" class="relative min-h-screen flex items-center overflow-hidden">

  <!-- Background image with overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src={hero.image}
      alt={hero.imageAlt}
      width="1920"
      height="1080"
      class="w-full h-full object-cover"
      fetchpriority="high"
      decoding="async"
      srcset={`${hero.image.replace('.webp','-400.webp')} 400w, ${hero.image.replace('.webp','-800.webp')} 800w, ${hero.image.replace('.webp','-1200.webp')} 1200w, ${hero.image} 1920w`}
      sizes="100vw"
    />
    <!-- Dark overlay -->
    <div class="absolute inset-0 bg-black/55"></div>
    <!-- Gradient overlay (fades to primary colour at bottom) -->
    <div class="absolute inset-0" style="background: linear-gradient(to bottom, transparent 40%, color-mix(in srgb, var(--color-primary) 60%, transparent));"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-20">
    <div class="max-w-2xl">

      <h1 class="font-heading font-bold text-4xl sm:text-5xl lg:text-6xl text-white leading-tight mb-6">
        {hero.headline}
      </h1>

      <p class="text-white/85 text-lg sm:text-xl leading-relaxed mb-8 max-w-xl">
        {hero.subheadline}
      </p>

      <!-- CTA row -->
      <div class="flex flex-col sm:flex-row gap-4 mb-6">
        <a
          href={hero.ctaHref}
          class="btn-hero-primary inline-flex items-center justify-center gap-2 px-8 py-4 rounded-lg font-semibold text-base text-white"
          style="background-color: var(--color-accent);"
        >
          {hero.ctaText}
        </a>
        <a
          href={`tel:${business.phone.replace(/\s/g,'')}`}
          class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-lg font-semibold text-base text-white border-2 border-white/50 hover:border-white hover:bg-white/10 transition-colors duration-150"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 6.75z"/>
          </svg>
          {business.phone}
        </a>
      </div>

      <!-- Trust subtext -->
      {hero.subtext && (
        <p class="text-white/60 text-sm flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" style="color: var(--color-accent);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
          </svg>
          {hero.subtext}
        </p>
      )}

    </div>
  </div>

  <!-- Scroll cue -->
  <div id="scroll-cue" class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-bounce">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
    </svg>
  </div>

</section>
